# Environment
NODE_ENV=development
PORT=5007

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_advisor?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Public URLs
ROOT_DOMAIN=businessadvisor.app
FRONTEND_URL=http://localhost:3007
BACKEND_URL=http://localhost:5007
ALLOW_TENANT_HEADER=true

# Platform Stripe (Business Advisor SaaS billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Stripe Connect foundation
STRIPE_CONNECT_CLIENT_ID=

# STEM Lantern portal connector (Skill Samurai portal during rebrand)
STEM_LANTERN_PORTAL_URL=http://localhost:5000
STEM_LANTERN_PORTAL_API_KEY=

# AI providers (Auto mode — order: OpenAI → Anthropic/Claude → Gemini)
# Defaults use each provider's high-capability model. Override with *_MODEL if needed.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-fable-5
# ANTHROPIC_EFFORT=max
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_THINKING_BUDGET=8192
#
# Privacy (request-level where supported):
# - OpenAI: store=false on every chat completion (API data not used for training by default;
#   org-level Zero Data Retention is a separate OpenAI agreement).
# - Anthropic: commercial API is not used for training by default; Zero Data Retention is
#   an org-level Anthropic agreement (contact sales), not a per-request flag.
# - Gemini: use a paid/billed Google AI project so prompts are not used to improve Google
#   products; Zero Data Retention is a separate Google project approval.

# Optional email (Brevo weekly executive brief)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@businessadvisor.app
# BREVO_SENDER_NAME=Business Advisor
