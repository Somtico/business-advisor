# Environment
NODE_ENV=development
PORT=5007

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_advisor?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Required in production. Dedicated privacy pseudonymization secret for learning/
# benchmark contributorKey HMAC. Must be different from JWT_SECRET. Keep stable:
# changing it without an intentional migration makes historical contributorKeys
# impossible to reproduce (withdrawal can no longer find prior anonymized rows).
# Development/test: if unset, a documented non-production fallback is used.
# Never fall back to JWT_SECRET in any environment.
LEARNING_CONTRIBUTOR_SALT=change-me-to-a-long-dedicated-learning-salt
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Public URLs
ROOT_DOMAIN=businessadvisor.app
FRONTEND_URL=http://localhost:3007
BACKEND_URL=http://localhost:5007
ALLOW_TENANT_HEADER=true

# Platform Stripe (Somtico Business Advisor SaaS billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Stripe Connect foundation
STRIPE_CONNECT_CLIENT_ID=

# STEM Lantern portal connector (Skill Samurai portal during rebrand)
STEM_LANTERN_PORTAL_URL=http://localhost:5000
STEM_LANTERN_PORTAL_API_KEY=

# ---------------------------------------------------------------------------
# AI providers (backend-only secrets — never VITE_* / NEXT_PUBLIC_*)
# Production route: Anthropic primary → OpenAI eligible-failure fallback →
# deterministic local fallback. Customer UI does not show provider/model names.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# AI_PRIMARY_PROVIDER=anthropic
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_ENABLED=true

# Primary model (official Anthropic API ID). Do not default to Opus.
# ANTHROPIC_MODEL=claude-sonnet-5
# Fallback model (official OpenAI API ID). Do not default to Sol.
# OPENAI_MODEL=gpt-5.6-terra

# Optional strategic / cheap overrides (not used for ordinary Ask Advisor)
# ANTHROPIC_STRATEGIC_MODEL=claude-opus-5
# ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5
# OPENAI_STRATEGIC_MODEL=gpt-5.6-sol
# OPENAI_CHEAP_MODEL=gpt-5.6-luna
# AI_ALLOW_EXPENSIVE_STRATEGIC_MODELS=false

# Guardrails
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=4096
# AI_MAX_TOOL_ROUNDS=6
# AI_MAX_PROVIDER_RETRIES=1
# AI_MAX_FALLBACK_ATTEMPTS=1
# AI_MAX_PROVIDER_CALLS_PER_REQUEST=6
# AI_MAX_HISTORY_MESSAGES=8

# Application-level cost caps (USD). Leave cushion under funded prepaid balances.
# AI_GLOBAL_DAILY_COST_CAP_USD=5
# AI_ORG_DAILY_COST_CAP_USD=2
# AI_ORG_MONTHLY_COST_CAP_USD=25
# AI_GLOBAL_MONTHLY_COST_CAP_USD=100
# ANTHROPIC_MONTHLY_COST_CAP_USD=80
# OPENAI_MONTHLY_COST_CAP_USD=8
# AI_BUDGET_WARNING_PERCENTAGES=50,80,100
# AI_BUDGET_HARD_BLOCK_PERCENT=100

# Circuit breaker (process-local; temporary only)
# AI_CIRCUIT_FAILURE_THRESHOLD=3
# AI_CIRCUIT_COOLDOWN_MS=60000

# Privacy (request-level where supported):
# - Anthropic: commercial API is not used for training by default; Zero Data Retention is
#   an org-level Anthropic agreement (contact sales), not a per-request flag.
# - OpenAI: store=false on every chat completion (API data not used for training by default;
#   org-level Zero Data Retention is a separate OpenAI agreement).
# Do not use claude-fable-5 / claude-mythos-5 when you need Zero Data Retention.

# Optional email (Brevo — weekly executive brief + signup verification)
# When unset, verification emails are dry-run logged and new owners are auto-verified for local/dev.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=noreply@businessadvisor.app
# BREVO_SENDER_NAME=Somtico Business Advisor
