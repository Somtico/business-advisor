generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  PILOT
  STARTER
  GROWTH
}

enum BillingCadence {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum OrganizationStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  FINANCE
  OPERATIONS
  ANALYST
  VIEWER
}

enum EducationSubtype {
  TUTORING_CENTRE
  STEM_ACADEMY
  MUSIC_ART_SCHOOL
  LANGUAGE_SCHOOL
  SPORTS_SKILLS_ACADEMY
  CAMP_ENRICHMENT
  MIXED_PROGRAMME_CENTRE
  OTHER
}

enum DataSourceKind {
  MANUAL
  CSV
  API_CONNECTOR
  DERIVED
}

enum DataSourceStatus {
  CONNECTED
  MANUAL
  MISSING
  STALE
  DERIVED
  NOT_APPLICABLE
}

enum EngagementStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  TRIAL
}

enum InsightSeverity {
  POSITIVE
  WARNING
  OPPORTUNITY
  TARGET_RISK
  COST
  DATA_QUALITY
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum ImpactType {
  SAVINGS
  REVENUE
}

enum ImpactRealizationSource {
  MEASURED
  USER_CONFIRMED
}

enum RecommendationSource {
  INSIGHT
  ADVISOR_CHAT
  MANUAL
}

enum EnrolmentTacticKey {
  TRIAL_FOLLOWUP
  FAMILY_REFERRAL
  SCHOOL_OUTREACH
  OPEN_HOUSE
  SCHEDULE_CHANGE
  WAITLIST
  PRICE_PROMO
  SOCIAL_ORGANIC
  PAID_ADS
  OTHER
}

enum TacticOutcome {
  HELPED
  NO_EFFECT
  HURT
  UNKNOWN
}

enum TacticCostBand {
  FREE
  LOW
  PAID
}

/// Owner decision on a recommendation (DecisionOutcome lifecycle).
enum OwnerDecision {
  ACCEPTED
  REJECTED
  DEFERRED
  MODIFIED
  NOT_ACTED
  UNKNOWN
}

/// Lifecycle outcome after action; NO_EFFECT and HURT are first-class learning signals.
enum LifecycleOutcome {
  PENDING
  HELPED
  NO_EFFECT
  HURT
  UNKNOWN
}

enum OutcomeVerificationType {
  NONE
  PENDING
  MEASURED
  USER_CONFIRMED
}

enum LearningEligibility {
  INELIGIBLE
  ELIGIBLE_PENDING_CONSENT
  SHARED
  WITHDRAWN_BLOCKED
}

enum MappingReviewStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ForecastScenario {
  CONSERVATIVE
  EXPECTED
  GROWTH
}

enum SyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  displayName          String?
  timezone             String             @default("America/Regina")
  currency             String             @default("CAD")
  country              String             @default("CA")
  fiscalYearStartMonth Int                @default(9)
  industryBlueprintKey String             @default("after_school_tutoring_enrichment")
  educationSubtype     EducationSubtype   @default(STEM_ACADEMY)
  /// Free-text subtype when educationSubtype is OTHER
  educationSubtypeOther String?
  status               OrganizationStatus @default(PENDING_PAYMENT)
  onboardingCompleted  Boolean            @default(false)
  cashBalanceCents     Int                @default(0)
  cashBalanceAsOf      DateTime?
  /// Contribution margin (%) targeted above the cost floor in pricing guidance
  pricingTargetMarginPercent Float        @default(30)
  stripeConnectAccountId String?
  stripeConnectReady   Boolean            @default(false)
  /// Soft “Help Improve Advisor” invite: after dismiss, hide until this timestamp.
  learningInviteSnoozedUntil DateTime?
  primaryColour        String?
  logoUrl              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  entitlement    OrganizationEntitlement?
  subscription   PlatformSubscription?
  domains        OrganizationDomain[]
  users          User[]
  auditEvents    AuditEvent[]
  locations      Location[]
  households     Household[]
  people         Person[]
  leads          Lead[]
  productServices ProductService[]
  engagements    Engagement[]
  sessions       Session[]
  capacityUnits  CapacityUnit[]
  staffMembers   StaffMember[]
  shifts         Shift[]
  compensationProfiles CompensationProfile[]
  revenueTransactions RevenueTransaction[]
  expenseTransactions ExpenseTransaction[]
  vendors        Vendor[]
  recurringSubscriptions RecurringSubscription[]
  loans          Loan[]
  marketingActivities MarketingActivity[]
  enrolmentTacticsTried EnrolmentTacticTried[]
  targets        Target[]
  forecasts      Forecast[]
  metricSnapshots MetricSnapshot[]
  insights       Insight[]
  recommendations Recommendation[]
  decisionOutcomes DecisionOutcome[]
  learningConsents LearningConsent[]
  alerts         Alert[]
  dataSources    DataSource[]
  externalIdentities ExternalIdentity[]
  customFields   CustomField[]
  customFieldValues CustomFieldValue[]
  dataReadinessItems DataReadinessItem[]
  aiUsageEvents  AiUsageEvent[]
  aiConversations AiConversation[]
  syncRuns       SyncRun[]
  onboardingTelemetry OnboardingTelemetry[]

  @@map("organizations")
}

model OrganizationDomain {
  id             String   @id @default(cuid())
  organizationId String
  hostname       String   @unique
  isCustom       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_domains")
}

model OrganizationEntitlement {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  plan              PlanTier @default(PILOT)
  adminSeatLimit    Int      @default(5)
  aiMonthlyTokenCap Int      @default(500000)
  connectorLimit    Int      @default(3)
  advancedReporting Boolean  @default(true)
  overrides         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_entitlements")
}

model PlatformSubscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  cadence              BillingCadence     @default(MONTHLY)
  status               SubscriptionStatus @default(INCOMPLETE)
  plan                 PlanTier           @default(PILOT)
  unitAmountCents      Int                @default(500)
  currency             String             @default("CAD")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("platform_subscriptions")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole @default(VIEWER)
  isActive       Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  /// One-time tokens already consumed (idempotent verify / StrictMode double-POST)
  usedVerificationTokens   Json     @default("[]")
  lastLoginAt    DateTime?
  termsAcceptedAt DateTime?
  termsVersion   String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownedRecommendations Recommendation[] @relation("RecommendationOwner")
  staffMember  StaffMember?

  @@unique([organizationId, email])
  @@index([emailVerificationToken])
  @@map("users")
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  addressLine1   String?
  city           String?
  province       String?
  postalCode     String?
  timezone       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]
  capacityUnits CapacityUnit[]
  shifts       Shift[]
  staffMembers StaffMember[]

  @@index([organizationId])
  @@map("locations")
}

model Household {
  id             String   @id @default(cuid())
  organizationId String
  displayName    String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  people       Person[]

  @@index([organizationId])
  @@map("households")
}

model Person {
  id             String    @id @default(cuid())
  organizationId String
  householdId    String?
  firstName      String
  lastName       String
  email          String?
  phone          String?
  gradeOrAge     String?
  status         String    @default("active")
  referralSource String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household    Household?   @relation(fields: [householdId], references: [id], onDelete: SetNull)
  engagements  Engagement[]
  leads        Lead[]

  @@index([organizationId, status])
  @@map("people")
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  personId       String?
  source         String?
  inquiryDate    DateTime  @default(now())
  trialBookedAt  DateTime?
  trialAttended  Boolean?
  convertedAt    DateTime?
  lostReason     String?
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("leads")
}

model ProductService {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  category       String?
  deliveryMode   String?
  priceCents     Int?
  durationMinutes Int?
  capacity       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  engagements  Engagement[]
  sessions     Session[]

  @@index([organizationId])
  @@map("product_services")
}

model Engagement {
  id               String           @id @default(cuid())
  organizationId   String
  personId         String
  productServiceId String?
  status           EngagementStatus @default(ACTIVE)
  isTrial          Boolean          @default(false)
  startDate        DateTime?
  endDate          DateTime?
  pausedAt         DateTime?
  cancelReason     String?
  discountCents    Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person         Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  sessions       Session[]

  @@index([organizationId, status])
  @@index([organizationId, startDate, endDate])
  @@map("engagements")
}

model CapacityUnit {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  name           String
  unitType       String   @default("seat")
  capacity       Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sessions     Session[]

  @@index([organizationId])
  @@map("capacity_units")
}

model Session {
  id               String    @id @default(cuid())
  organizationId   String
  locationId       String?
  productServiceId String?
  capacityUnitId   String?
  engagementId     String?
  staffMemberId    String?
  title            String?
  startsAt         DateTime
  endsAt           DateTime?
  capacity         Int?
  attendanceCount  Int?
  rosterCount      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)
  capacityUnit   CapacityUnit?   @relation(fields: [capacityUnitId], references: [id], onDelete: SetNull)
  engagement     Engagement?     @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  staffMember    StaffMember?    @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@map("sessions")
}

model StaffMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique
  locationId     String?
  firstName      String
  lastName       String
  email          String?
  roleTitle      String?
  skills         String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  shifts       Shift[]
  sessions     Session[]
  compensation CompensationProfile?

  @@index([organizationId])
  @@map("staff_members")
}

model CompensationProfile {
  id               String   @id @default(cuid())
  organizationId   String
  staffMemberId    String   @unique
  payType          String   @default("hourly")
  hourlyCents      Int?
  salaryAnnualCents Int?
  burdenPercent    Float    @default(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffMember  StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@map("compensation_profiles")
}

model Shift {
  id             String    @id @default(cuid())
  organizationId String
  staffMemberId  String
  locationId     String?
  startsAt       DateTime
  endsAt         DateTime
  actualHours    Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffMember  StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@map("shifts")
}

model RevenueTransaction {
  id             String    @id @default(cuid())
  organizationId String
  occurredAt     DateTime  @default(now())
  amountCents    Int
  category       String?
  description    String?
  isRecurring    Boolean   @default(false)
  sourceKind     DataSourceKind @default(MANUAL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@map("revenue_transactions")
}

model ExpenseTransaction {
  id             String    @id @default(cuid())
  organizationId String
  vendorId       String?
  occurredAt     DateTime  @default(now())
  amountCents    Int
  category       String?
  description    String?
  isRecurring    Boolean   @default(false)
  sourceKind     DataSourceKind @default(MANUAL)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@map("expense_transactions")
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String?
  website        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     ExpenseTransaction[]
  subscriptions RecurringSubscription[]

  @@index([organizationId])
  @@map("vendors")
}

model RecurringSubscription {
  id               String    @id @default(cuid())
  organizationId   String
  vendorId         String?
  name             String
  amountCents      Int
  cadence          String    @default("monthly")
  nextRenewalAt    DateTime?
  category         String?
  usageNotes       String?
  isActive         Boolean   @default(true)
  reviewPriority   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("recurring_subscriptions")
}

model Loan {
  id               String    @id @default(cuid())
  organizationId   String
  name             String
  principalCents   Int
  balanceCents     Int
  ratePercent      Float?
  paymentCents     Int?
  paymentCadence   String?
  maturityDate     DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("loans")
}

model MarketingActivity {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  channel        String?
  spendCents     Int       @default(0)
  leads          Int       @default(0)
  trials         Int       @default(0)
  conversions    Int       @default(0)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("marketing_activities")
}

/// Org-private log of enrolment tactics and results. Free-text never leaves this table.
model EnrolmentTacticTried {
  id              String            @id @default(cuid())
  organizationId  String
  tacticKey       EnrolmentTacticKey
  otherLabel      String?
  resultSummary   String
  outcome         TacticOutcome
  costBand        TacticCostBand
  shareAnonymized Boolean           @default(false)
  leakTypeAtReport String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("enrolment_tactics_tried")
}

/// De-identified tactic outcomes only: no org, person, or free text. Used for aggregate playbooks, not model training.
model AnonymizedTacticOutcome {
  id               String            @id @default(cuid())
  tacticKey        EnrolmentTacticKey
  outcome          TacticOutcome
  costBand         TacticCostBand
  leakType         String
  educationBucket  String
  purposeVersion   String            @default("playbook_counts_v1")
  createdAt        DateTime          @default(now())

  @@index([tacticKey, leakType, outcome])
  @@map("anonymized_tactic_outcomes")
}

model Target {
  id             String    @id @default(cuid())
  organizationId String
  metricKey      String
  label          String
  periodStart    DateTime
  periodEnd      DateTime
  targetValue    Float
  unit           String    @default("count")
  locationId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metricKey])
  @@map("targets")
}

model Forecast {
  id             String           @id @default(cuid())
  organizationId String
  metricKey      String
  scenario       ForecastScenario @default(EXPECTED)
  asOf           DateTime         @default(now())
  horizonEnd     DateTime
  projectedValue Float
  assumptions    Json?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metricKey, scenario])
  @@map("forecasts")
}

model MetricSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  metricKey      String
  asOf           DateTime @default(now())
  value          Float
  unit           String?
  dimensions     Json?
  evidence       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metricKey, asOf])
  @@map("metric_snapshots")
}

model Insight {
  id             String          @id @default(cuid())
  organizationId String
  severity       InsightSeverity
  title          String
  summary        String
  evidence       Json?
  metricKeys     String[]        @default([])
  acknowledgedAt DateTime?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@index([organizationId, createdAt])
  @@map("insights")
}

model Recommendation {
  id                 String               @id @default(cuid())
  organizationId     String
  insightId          String?
  ownerUserId        String?
  conversationId     String?
  source             RecommendationSource @default(INSIGHT)
  title              String
  description        String
  impactType         ImpactType?
  expectedImpactCents Int?
  expectedImpactNote String?
  status             RecommendationStatus @default(OPEN)
  completedAt        DateTime?
  /// Metric snapshot captured at completion so impact can be measured later
  baselineJson       Json?
  /// When the verification job (or user prompt) should evaluate realized impact
  verificationDueAt  DateTime?
  realizedImpactCents Int?
  realizedNote       String?
  realizedSource     ImpactRealizationSource?
  realizedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insight      Insight?     @relation(fields: [insightId], references: [id], onDelete: SetNull)
  owner        User?        @relation("RecommendationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  decisionOutcome DecisionOutcome?

  @@index([organizationId, status])
  @@index([organizationId, realizedAt])
  @@index([organizationId, verificationDueAt])
  @@map("recommendations")
}

/// Tenant-private diagnosis → decision → outcome lifecycle. Builds on Recommendation / Impact Ledger.
model DecisionOutcome {
  id                      String                   @id @default(cuid())
  organizationId          String
  recommendationId        String                   @unique
  schemaVersion           String                   @default("decision_outcome_v1")
  diagnosisCode           String?
  interventionCode        String?
  /// False for recommendations created before context snapshots existed.
  contextAvailable        Boolean                  @default(false)
  contextSchemaVersion    String?
  contextCapturedAt       DateTime?
  /// Versioned trusted context at recommendation creation (decision_context_v1). Exact values stay tenant-private.
  contextJson             Json?
  dataFreshness           String?
  confidence              Float?
  estimatedImpactCents    Int?
  estimatedImpactType     ImpactType?
  expectedOutcomeHorizonDays Int?
  ownerDecision           OwnerDecision            @default(UNKNOWN)
  decisionAt              DateTime?
  lifecycleOutcome        LifecycleOutcome         @default(PENDING)
  outcomeAt               DateTime?
  outcomeVerificationType OutcomeVerificationType  @default(NONE)
  realizedImpactCents     Int?
  learningEligibility     LearningEligibility      @default(INELIGIBLE)
  learningPurposeVersion  String?
  implementationVersion   String?
  routerVersion           String?
  anonymizedObservationId String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, diagnosisCode])
  @@index([organizationId, lifecycleOutcome])
  @@map("decision_outcomes")
}

/// Purpose/version-aware opt-in for cross-tenant learning (v2 outcomes, benchmarks).
model LearningConsent {
  id             String    @id @default(cuid())
  organizationId String
  purposeVersion String
  grantedAt      DateTime  @default(now())
  grantedByUserId String?
  withdrawnAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, purposeVersion])
  @@index([purposeVersion, withdrawnAt])
  @@map("learning_consents")
}

/// Privacy-safe V2 learning observations. No organizationId / PII / free text.
/// contributorKey = HMAC(purposeVersion:orgId) so withdrawal can delete without storing orgId.
/// Keys are purpose-specific: v2 and benchmark use different pseudonyms for the same org.
model AnonymizedOutcomeObservationV2 {
  id                   String            @id @default(cuid())
  schemaVersion        String            @default("outcome_observation_v2")
  purposeVersion       String            @default("somtico_models_v2")
  contributorKey       String
  educationSubtype     String?
  programmeCategory    String?
  activeEnrolmentBand  String?
  locationCountBand    String?
  utilizationBand      String?
  conversionHealth     String?
  retentionHealth      String?
  spareCapacityState   String?
  cashSafetyBand       String?
  seasonOrPeriod       String?
  diagnosedLeak        String?
  interventionCategory String?
  effortOrCostBand     String?
  outcome              LifecycleOutcome
  outcomeHorizonDays   Int?
  verificationType     OutcomeVerificationType
  createdAt            DateTime          @default(now())

  @@index([purposeVersion, diagnosedLeak, interventionCategory, outcome])
  @@index([contributorKey, purposeVersion])
  @@map("anonymized_outcome_observations_v2")
}

/// Metric dictionary for future benchmarks (customer UI deferred).
model BenchmarkMetricDefinition {
  id                String   @id @default(cuid())
  metricKey         String
  definitionVersion String
  label             String
  unit              String
  formulaSummary    String
  provenance        String
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  snapshots AnonymizedBenchmarkSnapshot[]

  @@unique([metricKey, definitionVersion])
  @@map("benchmark_metric_definitions")
}

/// Opt-in privacy-safe metric snapshots. No customer-facing exposure yet.
model AnonymizedBenchmarkSnapshot {
  id                    String   @id @default(cuid())
  schemaVersion         String   @default("benchmark_snapshot_v1")
  purposeVersion        String   @default("benchmark_snapshots_v1")
  contributorKey        String
  metricDefinitionId    String
  metricKey             String
  definitionVersion     String
  value                 Float
  educationSubtype      String?
  activeLearnerBand     String?
  programmeCategory     String?
  locationCountBand     String?
  maturityBand          String?
  geographyLevel        String?
  reportingPeriod       String?
  dataQualityStatus     String
  snapshotDate          DateTime
  createdAt             DateTime @default(now())

  metricDefinition BenchmarkMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@index([metricKey, definitionVersion, reportingPeriod])
  @@index([contributorKey, purposeVersion])
  @@map("anonymized_benchmark_snapshots")
}

/// Reviewed source→canonical mapping knowledge. No raw source row values.
model SourceMappingKnowledge {
  id                 String              @id @default(cuid())
  sourceSystemType   String
  schemaFingerprint  String
  sourceFieldName    String
  sourceDataType     String?
  proposedCanonical  String
  transformationRule String?
  confidence         Float               @default(0.5)
  reviewStatus       MappingReviewStatus @default(PROPOSED)
  successfulUses     Int                 @default(0)
  correctionCount    Int                 @default(0)
  version            Int                 @default(1)
  syntheticExample   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([sourceSystemType, schemaFingerprint, sourceFieldName, proposedCanonical, version])
  @@index([sourceSystemType, schemaFingerprint])
  @@index([reviewStatus, confidence])
  @@map("source_mapping_knowledge")
}

/// Internal onboarding timing for moat health (no PII).
model OnboardingTelemetry {
  id               String    @id @default(cuid())
  organizationId   String
  sourceSystemType String?
  startedAt        DateTime  @default(now())
  firstInsightAt   DateTime?
  mappingSteps     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("onboarding_telemetry")
}

/// Internal evaluation harness run results (not customer-facing).
model MoatEvaluationRun {
  id              String   @id @default(cuid())
  fixtureId       String
  provider        String
  model           String
  mode            String
  scoresJson      Json
  passed          Boolean
  notes           String?
  createdAt       DateTime @default(now())

  @@index([fixtureId, createdAt])
  @@map("moat_evaluation_runs")
}

model Alert {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  body           String
  severity       String    @default("warning")
  triggeredAt    DateTime  @default(now())
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, triggeredAt])
  @@map("alerts")
}

model DataSource {
  id             String           @id @default(cuid())
  organizationId String
  kind           DataSourceKind
  name           String
  status         DataSourceStatus @default(MISSING)
  connectorKey   String?
  config         Json?
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncRuns     SyncRun[]

  @@index([organizationId])
  @@map("data_sources")
}

model SyncRun {
  id             String        @id @default(cuid())
  organizationId String
  dataSourceId   String
  status         SyncRunStatus @default(PENDING)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  recordsUpserted Int          @default(0)
  errorMessage   String?
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataSource   DataSource   @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@map("sync_runs")
}

model ExternalIdentity {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  sourceSystem   String
  externalId     String
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, entityType, externalId])
  @@index([organizationId, entityType, entityId])
  @@map("external_identities")
}

model CustomField {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  key            String
  label          String
  dataType       String   @default("string")
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, key])
  @@map("custom_fields")
}

model CustomFieldValue {
  id             String   @id @default(cuid())
  organizationId String
  customFieldId  String
  entityId       String
  valueJson      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customField  CustomField  @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
  @@map("custom_field_values")
}

model DataReadinessItem {
  id             String           @id @default(cuid())
  organizationId String
  datasetKey     String
  label          String
  status         DataSourceStatus @default(MISSING)
  whyItMatters   String
  exampleInsight String?
  priority       Int              @default(50)
  deferredUntil  DateTime?
  notes          String?
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, datasetKey])
  @@map("data_readiness_items")
}

model AiUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  estimatedCostUsdCents Int @default(0)
  taskType       String?
  privacyPolicy  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ai_usage_events")
}

model AiConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages        AiMessage[]
  recommendations Recommendation[]

  @@index([organizationId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  /** Stored for the owning tenant users only; never exposed to platform admin tooling. */
  content        String
  toolCallsJson  Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
